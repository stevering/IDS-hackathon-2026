# Guardian MCP — rewrite OAuth consent redirect to local webapp in dev
GUARDIAN_WEBAPP_URL=http://localhost:3000

### Temporal.io — orchestration engine
# Local dev server (default — no TLS)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=guardian-orchestration
TEMPORAL_ENABLED=true
NEXT_PUBLIC_TEMPORAL_ENABLED=true
# Temporal Cloud — API key auth (recommended, set address to <ns>.<accountId>.tmprl.cloud:7233)
TEMPORAL_API_KEY=your-temporal-cloud-api-key

### Dev-only — your Supabase user UUID
# Used by `scripts/intercept.sh` and `scripts/replay-scenario.sh`. Each developer
# has their own UUID (`SELECT id FROM auth.users WHERE email = '<your-email>'`).
# Never hardcode in scripts, never commit a real value here.
INTERCEPT_USER_ID=
# Optional override — if unset, scripts fall back to INTERCEPT_USER_ID.
REPLAY_USER_ID=
