{
  "name": "guardian-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:web-prod": "bash scripts/dev.sh --web-prod",
    "dev:preview": "bash scripts/dev-preview.sh",
    "dev:prod": "GUARDIAN_URL=https://guardian.figdesys.com bash scripts/dev-preview.sh",
    "dev:apps": "turbo run dev --filter=@guardian/web --filter=@guardian/mcp-server --filter=@guardian/figma-plugin --filter=@guardian/figma-desktop-plugin --filter=@guardian/figma-widget --filter=@guardian/bridge --filter=@guardian/electron-overlay",
    "dev:figma": "turbo run dev --filter=@guardian/figma-plugin",
    "dev:web": "turbo run dev --filter=@guardian/web",
    "dev:web:proxy": "turbo run dev:proxy --filter=@guardian/web",
    "dev:proxy": "turbo run dev:proxy",
    "dev:mcp": "turbo run dev --filter=@guardian/mcp-server",
    "dev:extension": "turbo run dev --filter=@guardian/chrome-extension",
    "build:extension": "turbo run build --filter=@guardian/chrome-extension",
    "dev:overlay": "turbo run dev --filter=@guardian/electron-overlay",
    "build:overlay": "turbo run build --filter=@guardian/electron-overlay",
    "dev:supabase": "npx supabase start",
    "dev:supabase:stop": "npx supabase stop",
    "dev:supabase:clean": "npx supabase stop --no-backup",
    "dev:supabase:reset": "npx supabase stop --no-backup && npx supabase start",
    "dev:temporal-server": "temporal server start-dev",
    "dev:temporal": "pnpm --filter @guardian/temporal run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=origin/main",
    "version-packages": "changeset version && pnpm install --lockfile-only && node scripts/sync-manifests.mjs",
    "release": "pnpm build && changeset publish",
    "postinstall": "git config core.hooksPath scripts/git-hooks"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@dotenv-run/cli": "^1.3.6",
    "concurrently": "^9.2.1",
    "turbo": "^2.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "electron",
      "@swc/core",
      "protobufjs"
    ],
    "patchedDependencies": {
      "@ai-sdk/mcp@1.0.36": "patches/@ai-sdk__mcp@1.0.36.patch"
    }
  }
}
